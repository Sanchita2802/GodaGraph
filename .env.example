# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Maps JavaScript API key (optional; Leaflet runs as default fallback)
GOOGLE_MAPS_API_KEY="AIzaSyCpFj7LZFNS0FoCYDqYElY-gIR2ZALiH7I"

# Google Maps Map ID (optional; defaults to DEMO_MAP_ID)
GOOGLE_MAPS_MAP_ID="93e8a5bf56b110c6891cad90"

# Enable Google Routes API for real road geometry (optional; defaults to false)
ENABLE_GOOGLE_ROUTES="false"

# OpenStreetMap Nominatim reverse geocoder contact email (optional)
NOMINATIM_CONTACT_EMAIL=""

# Geocoder provider choice (optional; auto | nominatim | local; defaults to auto)
GEOCODER_PROVIDER="auto"

# Enable client-side Google Maps Geocoder when Google Maps is active (optional; defaults to false)
ENABLE_GOOGLE_GEOCODING="false"
