# ==============================================================================
# GodaGraph Environment Variables Reference
# Set these in your local .env file or your deployment provider (e.g. Vercel dashboard).
# NOTE: Never commit real API keys or secrets to version control.
# ==============================================================================

# [Server-only] Required for Gemini multimodal and NLP features (parse-trip, local friend, fares, clean stops).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# [Server-only] Optional override for Gemini model ID. Defaults to fallback chain: gemini-2.5-flash -> gemini-flash-latest.
GEMINI_MODEL=""

# [Server-only, served via /api/config] Google Maps JavaScript API key (optional; Leaflet runs as keyless default fallback).
# IMPORTANT: Protect in Google Cloud Console via HTTP Referrer restrictions (e.g. https://*.vercel.app/*, http://localhost:*).
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# [Server-only, served via /api/config] Google Cloud Map ID for Advanced Markers & vector styling (optional; defaults to DEMO_MAP_ID).
GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# [Server-only, served via /api/config] Enable Google Routes API for real road geometry (optional; defaults to false).
ENABLE_GOOGLE_ROUTES="false"

# [Server-only, served via /api/config] Enable client-side Google Maps Geocoder when Google Maps is active (optional; defaults to false).
ENABLE_GOOGLE_GEOCODING="false"

# [Server-only] Contact email included in Nominatim reverse geocoder User-Agent string (optional).
NOMINATIM_CONTACT_EMAIL=""

# [Server-only] Geocoder provider selection: auto | nominatim | local (optional; defaults to auto).
GEOCODER_PROVIDER="auto"

# [Server-only / Deployment] The canonical base URL where this applet is hosted (optional).
APP_URL="https://your-deployment-url.vercel.app"

# [Public / Build-time Client] Optional direct build-time Google Maps API key fallback if /api/config is unreachable.
# Note: Any variable prefixed with VITE_ is bundled into the client code.
VITE_GOOGLE_MAPS_API_KEY=""
